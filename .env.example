# Reference only: the gateway does not load dotenv files.
# Unauthenticated loopback demo; start demo-upstream first. No credentials needed.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
LOG_LEVEL=info
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
# Final-write allowance; MCP gets read + call + write budgets, not a global 15s cap.
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
MCP_UPSTREAM_ID=demo
MCP_UPSTREAM_URL=http://127.0.0.1:9090/mcp
MCP_CONNECT_TIMEOUT=5s
MCP_DISCOVERY_TIMEOUT=5s
MCP_CALL_TIMEOUT=5s
MCP_MAX_REQUEST_BYTES=1048576
